# Copy this file to .env (gitignored) and fill in real values.
# docker-compose.yml reads these for variable substitution automatically;
# `cargo run` / the release binary read the same names directly from the
# environment (or from .env via dotenvy, see src/lib.rs::run()).

# Your Audiobookshelf server URL.
ABS_URL=https://your-audiobookshelf-server.example

# Comma-separated username:api_key:password triples. These do not need to
# match your ABS account credentials -- pick any values you want your OPDS
# reader to log in with. Get the api_key from an ABS login response or from
# Settings > Users in ABS.
OPDS_USERS=myuser:YOUR_ABS_API_TOKEN:mypassword

# Uncomment to disable Basic Auth and auto-login as a single fixed ABS user
# (e.g. for e-readers that can't prompt for credentials, like KOReader).
# OPDS_NO_AUTH=true
# ABS_NOAUTH_USERNAME=myuser
# ABS_NOAUTH_PASSWORD=mypassword
